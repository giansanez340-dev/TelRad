    // BRANCH CHANGE
    branchFilter.addEventListener('change', function () {

        const selectedBranch =
            this.value;

        departmentFilter.innerHTML =
            '<option value="">All Departments</option>';

        subDepartmentContainer.style.display =
            'none';

        if (departments[selectedBranch]) {

            Object.keys(departments[selectedBranch])
                .forEach(function (department) {

                    const option =
                        document.createElement('option');

                    option.value =
                        department;

                    option.text =
                        department;

                    departmentFilter.appendChild(option);
                });
        }

        filterTable();
    });

    // DEPARTMENT CHANGE
    departmentFilter.addEventListener('change', function () {

        const selectedBranch =
            branchFilter.value;

        const selectedDepartment =
            this.value;

        subDepartmentFilter.innerHTML =
            '<option value="">Under</option>';

        const subDepartments =
            departments[selectedBranch]?.[selectedDepartment];

        filterTable();
    });

    searchFilter.addEventListener(
        'input',
        filterTable
    );

    subDepartmentFilter.addEventListener(
        'change',
        filterTable
    );

    // FILTER TABLE
    function filterTable() {

        const searchValue =
            searchFilter.value.toLowerCase();

        const branchValue =
            branchFilter.value;

        const departmentValue =
            departmentFilter.value;


        rows.forEach(function (row) {

            const name =
                row.dataset.name.toLowerCase();

            const branch =
                row.dataset.branch;

            const department =
                row.dataset.department;

            const subDepartment =
                row.dataset.subdepartment;

            const matchesSearch =
                name.includes(searchValue);

            const matchesBranch =
                !branchValue ||
                branch === branchValue;

            const matchesDepartment =
                !departmentValue ||
                department.toUpperCase() === departmentValue.toUpperCase();


            if (
                matchesSearch &&
                matchesBranch &&
                matchesDepartment &&
            ) {

                row.style.display = '';

            }
            else {

                row.style.display = 'none';
            }
        });
    }

</script>

