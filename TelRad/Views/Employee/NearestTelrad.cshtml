@model List<TelRad.Models.Employee>

@{
    ViewData["Title"] = "Nearest Telrad";
}

<h2 class="mb-4">Nearest Telrad Assignment</h2>

<!-- FILTERS -->
<div class="card p-4 mb-4">

    <div class="row">

        <!-- SEARCH -->
        <div class="col-md-3 mb-3">

            <label class="form-label">
                Search Employee
            </label>

            <input type="text"
                   id="searchFilter"
                   class="form-control"
                   placeholder="Search name..." />

        </div>

        <!-- BRANCH -->
        <div class="col-md-3 mb-3">

            <label class="form-label">
                Branch
            </label>

            <select id="branchFilter"
                    class="form-select">

                <option value="">
                    All Branches
                </option>

                <option value="Agoo">
                    Agoo
                </option>

                <option value="Candon">
                    Candon
                </option>

                <option value="RM">
                    RM
                </option>

                <option value="Pasig">
                    Pasig
                </option>

            </select>

        </div>

        <!-- DEPARTMENT -->
        <div class="col-md-3 mb-3">

            <label class="form-label">
                Department
            </label>

            <select id="departmentFilter"
                    class="form-select">

                <option value="">
                    All Departments
                </option>

            </select>

        </div>

        <!-- UNDER -->
        <div class="col-md-3 mb-3"
             id="subDepartmentContainer"
             style="display:none;">

            <label class="form-label">
                Under
            </label>

            <select id="subDepartmentFilter"
                    class="form-select">

                <option value="">
                    Under
                </option>

            </select>

        </div>

    </div>

</div>

<!-- TABLE -->
<div class="table-responsive">

    <table class="table table-bordered table-striped">

        <thead style="background:#17315e;
                      color: white;">

            <tr>

                <th>
                    Full Name
                </th>

                <th>
                    Branch
                </th>

                <th>
                    Department
                </th>

                <th>
                    Assigned Telrad
                </th>

                <th>
                    Nearest Telrad
                </th>


            </tr>

        </thead>

        <tbody id="employeeTableBody">

            @foreach (var employee in Model)
            {
                <tr data-name="@employee.FullName"
                    data-branch="@employee.Branch"
                    data-department="@employee.Department">

                    <td>
                        @employee.FullName
                    </td>

                    <td>
                        @employee.Branch
                    </td>

                    <td>
                        @employee.Department
                    </td>

                    <td>
                        @employee.AssignedTelrad
                    </td>

                    <td>
                        @employee.NearestTelrad
                    </td>
                    <td colspan="2">

                        <form asp-controller="Employee"
                              asp-action="AssignNearestTelrad"
                              method="post"
                              class="d-flex gap-2">

                            <input type="hidden"
                                   name="id"
                                   value="@employee.Id" />

                            <input type="text"
                                   name="nearestTelrad"
                                   class="form-control"
                                   value="@employee.NearestTelrad"
                                   placeholder="Nearest Telrad" />

                            <button type="submit"
                                    class="btn btn-primary">

                                Save

                            </button>

                        </form>

                    </td>
                </tr>
            }

        </tbody>

    </table>

</div>

