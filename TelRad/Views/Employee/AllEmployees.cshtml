@model List<TelRad.Models.Employee>

@{
    ViewData["Title"] = "All Employees";
}

<h2 class="mb-4">All Employees</h2>

<!-- FILTERS -->
<div class="card p-4 mb-4">

    <div class="row">

        <!-- BRANCH -->
        <div class="col-md-4 mb-3">

            <label class="form-label">
                Branch
            </label>

            <select id="branchFilter"
                    class="form-select">

                <option value="">
                    All Branches
                </option>

                <option value="Agoo">
                    Agoo
                </option>

                <option value="Candon">
                    Candon
                </option>

                <option value="RM">
                    RM
                </option>

                <option value="Pasig">
                    Pasig
                </option>

            </select>

        </div>

        <!-- DEPARTMENT -->
        <div class="col-md-4 mb-3">

            <label class="form-label">
                Department
            </label>

            <select id="departmentFilter"
                    class="form-select">

                <option value="">
                    All Departments
                </option>

            </select>

        </div>

        <!-- SUB DEPARTMENT -->
        <div class="col-md-4 mb-3"
             id="subDepartmentContainer"
             style="display:none;">

            <label class="form-label">
                Under
            </label>

            <select id="subDepartmentFilter"
                    class="form-select">

                <option value="">
                    Under
                </option>

            </select>

        </div>

    </div>

</div>

<!-- TABLE -->
<div class="table-responsive">

    <table class="table table-bordered table-striped">

        <thead style="background:#17315e;
                      color: white;">

            <tr>

                <th>
                    Full Name
                </th>

                <th>
                    Branch
                </th>

                <th>
                    Department
                </th>

                <th>
                    Under
                </th>

            </tr>

        </thead>

        <tbody id="employeeTableBody">

            @foreach (var employee in Model)
            {
                <tr data-branch="@employee.Branch"
                    data-department="@employee.Department">

                    <td>
                        @employee.FullName
                    </td>

                    <td>
                        @employee.Branch
                    </td>

                    <td>
                        @employee.Department
                    </td>

                
               
                </tr>
                        }

        </tbody>

    </table>

</div>

@section Scripts {

    <script>

        const branchFilter =
            document.getElementById('branchFilter');

        const departmentFilter =
            document.getElementById('departmentFilter');

        const subDepartmentFilter =
            document.getElementById('subDepartmentFilter');

        const subDepartmentContainer =
            document.getElementById('subDepartmentContainer');

        const rows =
            document.querySelectorAll('#employeeTableBody tr');

        // BRANCH -> DEPARTMENT -> SUBDEPARTMENT
        const departments = {

            "Agoo": {
                "Operator": [],
                "EXECOM": [],
                "LEAF": [],

                "SALES": [
                    "SAMPLE ROOM"
                ],

                "GROWING OPERATION": [
                    "AGRONOMY",
                    "SSDG"
                ],

                "FINANCE": [
                    "ACCOUNTING",
                    "HUMAN RESOURCES",
                    "INFORMATION TECHNOLOGY"
                ],

                "INTERNAL OPERATIONS": [
                    "ENGINEERING",
                    "EHSS"
                ]
            },

            "Candon": {

                "EXECOM": [],

                "FINANCE": [
                    "OPERATIONS ACCOUNTING",
                    "INFORMATION TECHNOLOGY",
                    "HUMAN RESOURCE"
                ],

                "INTERNAL OPERATIONS": [
                    "GLLM",
                    "ENGINEERING",
                    "GUARD"
                ]
            },

            "RM": {

                "Operator": [],

                "FINANCE": [],

                "LEAF AND SALES": [
                    "GENERAL ACCOUNTING",
                    "LEAF ACCOUNTING"
                ]
            },

            "Pasig": {

                "Operator": [],

                "EXECOM": [],

                "FINANCE": [
                    "CONFERENCE",
                    "TREASURY"
                ]
            }
        };

        // BRANCH CHANGED
        branchFilter.addEventListener('change', function () {

            const selectedBranch =
                this.value;

            departmentFilter.innerHTML =
                '<option value="">All Departments</option>';

            subDepartmentFilter.innerHTML =
                '<option value="">Under</option>';

            subDepartmentContainer.style.display =
                'none';

            if (departments[selectedBranch]) {

                Object.keys(departments[selectedBranch])
                    .forEach(function (department) {

                        const option =
                            document.createElement('option');

                        option.value =
                            department;

                        option.text =
                            department;

                        departmentFilter.appendChild(option);
                    });
            }

            filterTable();
        });

        // DEPARTMENT CHANGED
        departmentFilter.addEventListener('change', function () {

            const selectedBranch =
                branchFilter.value;

            const selectedDepartment =
                this.value;

            subDepartmentFilter.innerHTML =
                '<option value="">N/A</option>';

            const subDepartments =
                departments[selectedBranch]?.[selectedDepartment];

            if (
                subDepartments &&
                subDepartments.length > 0
            ) {

                subDepartmentContainer.style.display =
                    'block';

                subDepartments.forEach(function (subDept) {

                    const option =
                        document.createElement('option');

                    option.value =
                        subDept;

                    option.text =
                        subDept;

                    subDepartmentFilter.appendChild(option);
                });
            }
            else {

                subDepartmentContainer.style.display =
                    'none';
            }

            filterTable();
        });

        // SUBDEPARTMENT CHANGED
        subDepartmentFilter.addEventListener(
            'change',
            filterTable
        );

        // FILTER TABLE
        function filterTable() {

            const branchValue =
                branchFilter.value;

            const departmentValue =
                departmentFilter.value;

            const subDepartmentValue =
                subDepartmentFilter.value;

            rows.forEach(function (row) {

                const branch =
                    row.dataset.branch;

                const department =
                    row.dataset.department;

                const subDepartment =
                    row.dataset.subdepartment;

                const matchesBranch =
                    !branchValue ||
                    branch === branchValue;

                const matchesDepartment =
                    !departmentValue ||
                    department === departmentValue;

                const matchesSubDepartment =
                    !subDepartmentValue ||
                    subDepartment === subDepartmentValue;

                if (
                    matchesBranch &&
                    matchesDepartment &&
                    matchesSubDepartment
                ) {

                    row.style.display = '';

                }
                else {

                    row.style.display = 'none';
                }
            });
        }

    </script>

}