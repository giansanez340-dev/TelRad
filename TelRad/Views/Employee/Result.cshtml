@model TelRad.Models.SearchResultViewModel

@{
    ViewData["Title"] = "Employee Result";
}

<h2>Employee Result</h2>

<div class="card p-4">

    <h4>Employee Information</h4>

    <p>
        <strong>Full Name:</strong>
        @Model.Employee?.FullName
    </p>

    <p>
        <strong>Branch:</strong>
        @Model.Employee?.Branch
    </p>

    <p>
        <strong>Department:</strong>
        @Model.Employee?.Department
    </p>


    <hr />
    <h4> Telrad </h4>
    <p>
            <strong>Assigned Telrad Number:</strong>
        @Model.Employee?.AssignedTelrad
    </p>

    <p>
            <strong>Nearest Telrad:</strong>
        @(
                string.IsNullOrWhiteSpace(Model.Employee?.NearestTelrad)
                ? "No nearest telrad assigned"
                : Model.Employee?.NearestTelrad
                )
    </p>

</div>

<br />

<a asp-controller="Employee"
   asp-action="Search"
   class="btn btn-secondary">

    Back

</a> 