@model List<TelRad.Models.Employee>

@{
    ViewData["Title"] = "Nearest Telrad";
}

<h2 class="mb-4">Nearest Telrad Assignment</h2>

<!-- ================= SEARCH + FILTERS ================= -->
<div class="card p-4 mb-4">

    <div class="row">

        <!-- SEARCH -->
        <div class="col-md-4 mb-3">
            <label class="form-label">Search Employee</label>
            <input type="text"
                   id="searchFilter"
                   class="form-control"
                   placeholder="Search employee..." />
        </div>

        <!-- BRANCH -->
        <div class="col-md-4 mb-3">
            <label class="form-label">Branch</label>
            <input type="text"
                   id="branchFilter"
                   class="form-control"
                   list="branchList"
                   placeholder="Select or type branch..." />

            <datalist id="branchList">
                <option value="Agoo"></option>
                <option value="Candon"></option>
                <option value="RM"></option>
                <option value="Pasig"></option>
            </datalist>
        </div>

        <!-- DEPARTMENT -->
        <div class="col-md-4 mb-3">
            <label class="form-label">Department</label>
            <input type="text"
                   id="departmentFilter"
                   class="form-control"
                   list="departmentList"
                   placeholder="Select or type department..." />

            <datalist id="departmentList"></datalist>
        </div>

    </div>

</div>

<!-- ================= TABLE ================= -->
<div class="table-responsive">

    <table class="table table-striped align-middle">

        <thead style="background:#17315e; color:white;">
            <tr>
                <th>Full Name</th>
                <th>Branch</th>
                <th>Department</th>
                <th>Assigned Telrad</th>
                <th>Nearest Telrad</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody id="employeeTableBody">

            @foreach (var employee in Model)
            {
                <tr class="main-row" data-id="@employee.Id">

                    <td>@employee.FullName</td>
                    <td>@employee.Branch</td>
                    <td>@employee.Department</td>
                    <td>@employee.AssignedTelrad</td>
                    <td>@employee.NearestTelrad</td>

                    <td>
                        <button type="button"
                                class="btnAdmin btnAdmin-p btnAdmin-sm edit-btn">
                            Edit
                        </button>
                    </td>

                </tr>

                <!-- EXPANDED EDIT ROW -->
                <tr class="edit-row d-none" id="edit-@employee.Id">

                    <td colspan="6">

                        <div class="card p-3">

                            <div class="row g-2">

                                <div class="col-md-4">
                                    <label>Full Name</label>
                                    <input class="form-control fullName" value="@employee.FullName" />
                                </div>

                                <div class="col-md-4">
                                    <label>Branch</label>
                                    <input class="form-control branch" value="@employee.Branch" />
                                </div>

                                <div class="col-md-4">
                                    <label>Department</label>
                                    <input class="form-control department" value="@employee.Department" />
                                </div>

                                <div class="col-md-6">
                                    <label>Assigned Telrad</label>
                                    <input class="form-control assigned" value="@employee.AssignedTelrad" />
                                </div>

                                <div class="col-md-6">
                                    <label>Nearest Telrad</label>
                                    <input class="form-control nearest" value="@employee.NearestTelrad" />
                                </div>

                            </div>

                            <!-- ACTIONS -->
                            <div class="mt-3 d-flex gap-2">

                                <button type="button"
                                        class="btnAdmin btnAdmin-g save-btn">
                                    Save
                                </button>

                                <button type="button"
                                        class="btnAdmin btnAdmin-r cancel-btn">
                                    Cancel
                                </button>

                            </div>

                        </div>

                    </td>

                </tr>
            }

        </tbody>

    </table>



</div>

<!-- ================= SCRIPTS ================= -->
<script>

    // ================= ELEMENTS =================
    const searchFilter = document.getElementById('searchFilter');
    const branchFilter = document.getElementById('branchFilter');
    const departmentFilter = document.getElementById('departmentFilter');
    const departmentList = document.getElementById('departmentList');
    const rows = document.querySelectorAll('#employeeTableBody tr');

    const menu = document.getElementById("rowActionMenu");
    let selectedRow = null;

    // ================= DEPARTMENTS =================
    const departments = {
        "Agoo": ["Operator", "HR", "IT"],
        "Candon": ["Admin", "IT"],
        "RM": ["Finance", "HR"],
        "Pasig": ["Operations", "IT"]
    };

    // ================= FILTER FUNCTION =================
    function filterTable() {

        const searchValue = searchFilter.value.toLowerCase();
        const branchValue = branchFilter.value.toLowerCase();
        const departmentValue = departmentFilter.value.toLowerCase();

        rows.forEach(row => {

            const name = row.dataset.name.toLowerCase();
            const branch = row.dataset.branch.toLowerCase();
            const department = row.dataset.department.toLowerCase();

            const matchSearch = name.includes(searchValue);
            const matchBranch = !branchValue || branch.includes(branchValue);
            const matchDept = !departmentValue || department.includes(departmentValue);

            row.style.display =
                (matchSearch && matchBranch && matchDept) ? '' : 'none';
        });
    }

    // ================= FILTER EVENTS =================
    searchFilter.addEventListener('input', filterTable);
    branchFilter.addEventListener('input', function () {

        // update department list
        departmentList.innerHTML = '';

        if (departments[this.value]) {
            departments[this.value].forEach(d => {
                const opt = document.createElement('option');
                opt.value = d;
                departmentList.appendChild(opt);
            });
        }

        filterTable();
    });

    departmentFilter.addEventListener('input', filterTable);

    // ================= ROW ACTION MENU =================
    document.querySelectorAll("#employeeTableBody tr").forEach(row => {
        row.addEventListener("click", function () {

            selectedRow = this;

            const rect = this.getBoundingClientRect();

            menu.style.top = (rect.top + window.scrollY - 45) + "px";
            menu.style.left = (rect.left + window.scrollX + rect.width / 2) + "px";

            menu.classList.remove("d-none");
        });
    });

    // hide menu when clicking outside
    document.addEventListener("click", function (e) {
        if (!menu.contains(e.target) && !e.target.closest("tr")) {
            menu.classList.add("d-none");
        }
    });

    // ================= EDIT BUTTON =================
    document.querySelectorAll('.edit-btn').forEach(btn => {
        btn.addEventListener('click', function () {

            const mainRow = this.closest('tr');
            const id = mainRow.dataset.id;
            const editRow = document.getElementById('edit-' + id);

            editRow.classList.remove('d-none');
        });
    });

    // ================= CANCEL BUTTON =================
    document.querySelectorAll('.cancel-btn').forEach(btn => {
        btn.addEventListener('click', function () {

            const editRow = this.closest('.edit-row');
            editRow.classList.add('d-none');
        });
    });

    // ================= SAVE BUTTON =================
    document.querySelectorAll('.save-btn').forEach(btn => {

        btn.addEventListener('click', function () {

            const editRow = this.closest('.edit-row');
            const mainRow = editRow.previousElementSibling;

            const id = mainRow.dataset.id;

            const data = {
                Id: id,
                FullName: editRow.querySelector('.fullName').value,
                Branch: editRow.querySelector('.branch').value,
                Department: editRow.querySelector('.department').value,
                AssignedTelrad: editRow.querySelector('.assigned').value,
                NearestTelrad: editRow.querySelector('.nearest').value
            };

            fetch('/Employee/UpdateEmployee', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            })
            .then(res => res.json())
            .then(() => {
                location.reload();
            });
        });
    });

</script>