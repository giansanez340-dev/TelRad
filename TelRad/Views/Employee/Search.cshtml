@model List<TelRad.Models.Employee>

@{
    ViewData["Title"] = "Nearest Telrad";
    bool isAdmin = User.Identity != null && User.Identity.IsAuthenticated && User.IsInRole("Admin");
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<h2 class="mb-4">Local IP Phone Directory</h2>

<!-- FILTERS -->
<div class="mb-4 px-3">
    <!-- ROW 1: Employee Cards -->
    <div class="row g-3 mb-3">

        <div class="col-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center" style="background: #2957a6; border-radius: 5px;">
                    <div>
                        <div class="text-white fw-bold small">Total Employees</div>
                        <div class="text-white fs-4 fw-bold" id="countTotal">
                            @Model.Select(x => x.FullName).Distinct().Count()
                        </div>
                    </div>
                    <i class="bi bi-people-fill fs-2 text-white"></i>
                </div>
            </div>
        </div>

        <div class="col-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center" style="background: #0891b2; border-radius: 5px;">
                    <div>
                        <div class="text-white fw-bold small">Active Employees</div>
                        <div class="fs-4 fw-bold text-white" id="countActiveEmployees">
                            @(Model.Count(x => x.IsActive && !string.IsNullOrEmpty(x.AssignedTelrad)))
                        </div>
                    </div>
                    <i class="bi bi-person-check-fill fs-2 text-white"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- ROW 2: Telrad Cards -->
    <div class="row g-3 mb-3">

        <div class="col-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center" style="background: #4b3C83; border-radius: 5px;">
                    <div>
                        <div class="text-white fw-bold small">Total Telrads</div>
                        <div class="fs-4 fw-bold text-white" id="countTotalTelrads">
                            @(Model.Where(x => !string.IsNullOrEmpty(x.AssignedTelrad))
                                                        .Select(x => x.AssignedTelrad).Distinct().Count())
                        </div>
                    </div>
                    <i class="bi bi-telephone-fill fs-2 text-white"></i>
                </div>
            </div>
        </div>

        <div class="col-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center" style="background: #2dc882; border-radius: 5px;">
                    <div>
                        <div class="text-white fw-bold small">Active Telrads</div>
                        <div class="fs-4 fw-bold text-white" id="countActive">
                            @(Model.Where(x => x.IsActive && !string.IsNullOrEmpty(x.AssignedTelrad))
                                                        .Select(x => x.AssignedTelrad).Distinct().Count())
                        </div>
                    </div>
                    <i class="bi bi-check-circle-fill fs-2 text-white"></i>
                </div>
            </div>
        </div>

        <div class="col-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex justify-content-between align-items-center" style="background: #ea6070; border-radius: 5px;">
                    <div>
                        <div class="text-white fw-bold small">Inactive Telrads</div>
                        <div class="fs-4 fw-bold text-white" id="countInactive">
                            @(Model.Where(x => !x.IsActive && !string.IsNullOrEmpty(x.AssignedTelrad))
                                                        .Select(x => x.AssignedTelrad).Distinct().Count())
                        </div>
                    </div>
                    <i class="bi bi-x-circle-fill fs-2 text-white"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- FILTER + ADD CARD -->
    <div class="card shadow-sm border-1">
        <div class="card-body">

            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0 fw-semibold">Filters & Management</h6>
            </div>

            <!-- FILTER ROW -->
            <div class="row g-3">

                <div class="col-md-4">
                    <label class="form-label text-muted small">Search</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               id="searchFilter"
                               class="form-control"
                               placeholder="Name">
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-muted small">Branch</label>
                    <select id="branchFilter" class="form-select">
                        <option value="">All Branches</option>
                        <option value="Agoo">Agoo</option>
                        <option value="Candon">Candon</option>
                        <option value="RM">RM</option>
                        <option value="Pasig">Pasig</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label text-muted small">Department</label>
                    <div class="dropdown">
                        <button class="form-select text-start" type="button" data-bs-toggle="dropdown" id="departmentBtn">
                            All Departments
                        </button>
                        <ul class="dropdown-menu p-0" id="departmentDropdown"
                            style="max-height: 180px; overflow-y:auto; width:100%;">
                            <li><a class="dropdown-item dept-item" data-value="">All Departments</a></li>
                        </ul>
                    </div>
                </div>

            </div>

            <!-- ADD EMPLOYEE -->
            <hr class="my-4">

            <form id="inlineAddForm" class="row g-2 align-items-end">

                @Html.AntiForgeryToken()

                <div class="col-md-3">
                    <label class="form-label text-muted small">Assigned Telrad</label>
                    <input type="text"
                           id="telradFilter"
                           class="form-control"
                           placeholder="Filter by assigned telrad">
                </div>

                <div class="col-md-3">
                    <label class="form-label text-muted small">Nearest Telrad</label>
                    <input type="text"
                           id="addNearestTelrad"
                           name="nearestTelrad"
                           class="form-control"
                           placeholder="Enter nearest number">
                </div>

                <div class="col-md-3">
                    <label class="form-label text-muted small">Position</label>
                    <input type="text"
                           id="addPosition"
                           name="position"
                           class="form-control"
                           placeholder="Enter position">
                </div>

                @if (isAdmin)
                {
                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100 fw-semibold">
                            <i class="bi bi-plus-lg me-1"></i> Add Employee
                        </button>
                    </div>
                }

            </form>
        </div>
    </div>

</div>

<!-- TABLE -->
<div class="table-responsive px-4">
    <table class="table table-hover align-middle custom-table">
        <thead style="background:#17315e; color:white; align-items: center;">
            <tr>
                <th style="width: 50px; text-align: center;">Main</th>
                <th class="text-start">Full Name</th>
                <th>Branch</th>
                <th>Department</th>
                <th>Number</th>
                <th>Assigned Telrad</th>
                <th>Nearest Telrad</th>
                <th>Employee Status</th>
                <th>Telrad Status</th>
                <th></th>
            </tr>
        </thead>

        <tbody id="employeeTableBody">

            @{
                var grouped = Model.GroupBy(e => e.AssignedTelrad);
            }

            @foreach (var group in grouped)
            {
                bool groupIsActive = group.First().IsActive;
                int representativeId = group.First().Id;

                foreach (var employee in group)
                {
                    <tr data-name="@employee.FullName"
                        data-branch="@employee.Branch"
                        data-department="@employee.Department"
                        data-assignedtelrad="@employee.AssignedTelrad"
                        data-mainhandler="@(employee.IsMainHandler ? "true" : "false")"
                        data-isactive="@(employee.IsActive ? "true" : "false")">

                        <td>
                            <input type="checkbox"
                                   class="main-handler-checkbox"
                                   data-telrad="@employee.AssignedTelrad"
                                   data-employeeid="@employee.Id"
                                   @(employee.IsMainHandler ? "checked" : "")
                                   disabled />
                            <input type="hidden"
                                   name="IsMainHandler"
                                   class="main-handler-hidden"
                                   data-mainhandler="@(employee.IsMainHandler ? "true" : "false")">
                        </td>

                        <td class="text-start">
                            <span class="cell-text">@employee.FullName</span>
                            <input class="form-control edit-input" name="FullName" value="@employee.FullName" />
                        </td>

                        <td>
                            <span class="cell-text">@employee.Branch</span>
                            <input class="form-control edit-input" name="Branch" value="@employee.Branch" />
                        </td>

                        <td>
                            <span class="cell-text">
                                @employee.Department
                                @if (!string.IsNullOrEmpty(employee.Position))
                                {
                                    <br />
                    
                                    <small class="text-muted">@employee.Position</small>
                                }
                            </span>
                            <input class="form-control edit-input" name="Department" value="@employee.Department" />
                        </td>

                        <td>
                            <span class="cell-text">@employee.Number</span>
                            <input class="form-control edit-input" name="Number" value="@employee.Number" />
                        </td>

                        <td>
                            <span class="cell-text">@employee.AssignedTelrad</span>
                            <input class="form-control edit-input" name="AssignedTelrad" value="@employee.AssignedTelrad" />
                        </td>

                        <td>
                            <span class="cell-text">@employee.NearestTelrad</span>
                            <input class="form-control edit-input" name="NearestTelrad" value="@employee.NearestTelrad" />
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(employee.AssignedTelrad))
                            {
                                <span class="badge bg-secondary">No Telrad Assigned</span>
                            }
                            else
                            {
                                <span class="badge employee-status-badge @(employee.IsActive ? "bg-success" : "bg-danger")">
                                    @(employee.IsActive ? "Active" : "Inactive")
                                </span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(employee.AssignedTelrad))
                            {
                                bool telradActive = Model.Any(x => x.AssignedTelrad == employee.AssignedTelrad && x.IsActive);
                                <span class="badge telrad-status-badge @(telradActive ? "bg-success" : "bg-danger")">
                                    @(telradActive ? "Active" : "Inactive")
                                </span>
                            }
                        </td>

                        @if (isAdmin)
                        {
                            <td class="actions-column">
                                <div class="d-flex gap-2 justify-content-end">

                                    <button type="button"
                                            class="btn toggle-active-btn d-none @(groupIsActive ? "active-state" : "")"
                                            data-employeeid="@representativeId"
                                            data-isactive="@(groupIsActive ? "true" : "false")"
                                            title="@(groupIsActive ? "Set Inactive" : "Set Active")">
                                        <i class="bi @(groupIsActive ? "bi-toggle-on text-success" : "bi-toggle-off text-danger")"></i>
                                    </button>

                                    <button type="button" class="btn btn-warning edit-btn btn-sm">
                                        <i class="bi bi-pencil"></i>
                                    </button>

                                    <form asp-controller="Employee" asp-action="UpdateEmployee" method="post" class="d-none save-form">
                                        <input type="hidden" name="Id" value="@employee.Id" />
                                        <input type="hidden" name="IsMainHandler" class="main-handler-hidden" value="@employee.IsMainHandler" />
                                        <input type="hidden" name="FullName" value="@employee.FullName" />
                                        <input type="hidden" name="Branch" value="@employee.Branch" />
                                        <input type="hidden" name="Department" value="@employee.Department" />
                                        <input type="hidden" name="Position" value="@employee.Position" />
                                        <input type="hidden" name="Number" value="@employee.Number" />
                                        <input type="hidden" name="AssignedTelrad" value="@employee.AssignedTelrad" />
                                        <input type="hidden" name="NearestTelrad" value="@employee.NearestTelrad" />
                                        <button type="submit" class="btn btn-success save-btn btn-sm">Save</button>
                                    </form>

                                    <form asp-controller="employee"
                                          asp-action="deleteemployee"
                                          method="post"
                                          class="d-none delete-form"
                                          onsubmit="return confirm('delete this employee?');">
                                        <input type="hidden" name="id" value="@employee.Id" />
                                        <button type="submit" class="btn delete-btn btn-danger btn-sm">delete</button>
                                    </form>

                                </div>
                            </td>
                        }

                    </tr>
                }
            }

        </tbody>
    </table>
</div>

<!-- RESPONSE MODAL -->
<div id="responseModal" class="custom-modal">
    <div class="custom-modal-content">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 id="responseModalTitle" class="mb-0">Message</h5>
            <button type="button"
                    class="btn-close"
                    id="closeResponseModal">
            </button>
        </div>

        <div id="responseModalBody"></div>

        <div class="text-end mt-3">
            <button type="button"
                    class="btn btn-primary"
                    id="responseModalOk">
                OK
            </button>
        </div>

    </div>
</div>

<!-- TOGGLE SCOPE MODAL -->
<div id="toggleScopeModal" class="custom-modal">
    <div class="custom-modal-content">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="mb-0">Toggle Status</h5>
            <button type="button" class="btn-close" id="closeScopeModal"></button>
        </div>

        <p id="toggleScopeMessage" class="text-muted mb-4"></p>

        <div class="d-grid gap-2">
            <button type="button" class="btn btn-outline-primary" id="toggleScopeEmployee">
                <i class="bi bi-person me-2"></i> This Employee Only
            </button>
            <button type="button" class="btn btn-outline-danger" id="toggleScopeTelrad">
                <i class="bi bi-telephone me-2"></i> Entire Telrad
            </button>
        </div>

        <div class="text-end mt-3">
            <button type="button" class="btn btn-secondary btn-sm" id="cancelScopeModal">Cancel</button>
        </div>

    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mt-3">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-3">@TempData["Error"]</div>
}

@section Scripts {
    <script>
        const searchFilter = document.getElementById('searchFilter');
        const branchFilter = document.getElementById('branchFilter');
        const telradFilter = document.getElementById('telradFilter');
        const inlineAddForm = document.getElementById('inlineAddForm');

        const departments = {
            "Agoo": [
                "ACCOUNTING", "AGRONOMY", "CORPORATE AFFAIRS AND COMPLIANCE", "ENGINEERING",
                "ENVIRONMENT, HEALTH, SAFETY AND SECURITY", "FINISHED GOODS I", "GO REGION I",
                "GREEN LEAF LOGISTICS", "GROWING", "HUMAN RESOURCE MANAGEMENT",
                "INFORMATION TECHNOLOGY DEPARTMENT", "LEAF OPERATIONS I", "LEAF OPERATIONS II",
                "LEGAL SERVICES, ENTERPRISE RISK MANAGEMENT, AUDIT GROUP, AND DATA PROTECTION AND MANAGEMENT",
                "PROCUREMENT AND SHIPPING", "PRODUCTION I", "QUALITY CONTROL", "SALES",
                "SYSTEMS AND STANDARDS DEVELOPMENT GROUP", "TAX COMPLIANCE",
                "TRAFFIC MANAGEMENT GROUP", "TREASURY"
            ],
            "Candon": [
                "ACCOUNTING", "AGRONOMY", "ENGINEERING", "ENVIRONMENT, HEALTH, SAFETY AND SECURITY",
                "GO REGION I", "GREEN LEAF LOGISTICS", "HUMAN RESOURCE MANAGEMENT",
                "INFORMATION TECHNOLOGY DEPARTMENT", "LEAF OPERATIONS I",
                "LEGAL SERVICES, ENTERPRISE RISK MANAGEMENT, AUDIT GROUP, AND DATA PROTECTION AND MANAGEMENT",
                "PROCUREMENT AND SHIPPING", "SYSTEMS AND STANDARDS DEVELOPMENT GROUP",
                "TAX COMPLIANCE", "TRAFFIC MANAGEMENT GROUP", "TREASURY"
            ],
            "RM": [
                "ACCOUNTING", "AGRONOMY", "CORPORATE AFFAIRS AND COMPLIANCE", "ENGINEERING",
                "ENVIRONMENT, HEALTH, SAFETY AND SECURITY", "EXTERNAL AFFAIRS AND OPERATIONS",
                "FINISHED GOODS II", "GO REGION II", "GREEN LEAF LOGISTICS",
                "HUMAN RESOURCE MANAGEMENT", "INFORMATION TECHNOLOGY DEPARTMENT", "LEAF OPERATIONS II",
                "LEGAL SERVICES, ENTERPRISE RISK MANAGEMENT, AUDIT GROUP, AND DATA PROTECTION AND MANAGEMENT",
                "PRECISION AGRICULTURE", "PROCUREMENT AND SHIPPING", "PRODUCTION II",
                "QUALITY CONTROL", "SYSTEMS AND STANDARDS DEVELOPMENT GROUP", "TAX COMPLIANCE",
                "TRAFFIC MANAGEMENT GROUP", "TREASURY"
            ],
            "Pasig": [
                "CORPORATE AFFAIRS AND COMPLIANCE", "INFORMATION TECHNOLOGY DEPARTMENT",
                "LEGAL SERVICES, ENTERPRISE RISK MANAGEMENT, AUDIT GROUP, AND DATA PROTECTION AND MANAGEMENT",
                "PROCUREMENT AND SHIPPING", "SALES", "TREASURY"
            ]
        };

        // ===============================
        // DEPARTMENT DROPDOWN
        // ===============================
        function populateDepartments(branch = "") {
            const dropdown = document.getElementById('departmentDropdown');
            dropdown.innerHTML = `<li><a class="dropdown-item dept-item" data-value="">All Departments</a></li>`;
            let list = [];
            if (branch && departments[branch]) {
                list = departments[branch];
            } else {
                Object.values(departments).forEach(arr => list.push(...arr));
            }
            list = [...new Set(list)].sort();
            list.forEach(d => {
                const li = document.createElement('li');
                li.innerHTML = `<a class="dropdown-item dept-item" data-value="${d}">${d}</a>`;
                dropdown.appendChild(li);
            });
            attachDeptEvents();
        }

        function attachDeptEvents() {
            document.querySelectorAll('.dept-item').forEach(item => {
                item.addEventListener('click', function () {
                    const value = this.dataset.value;
                    const btn = document.getElementById('departmentBtn');
                    btn.textContent = value || 'All Departments';
                    btn.dataset.value = value;
                    filterTable();
                });
            });
        }

        populateDepartments();
        searchFilter?.addEventListener('input', filterTable);
        branchFilter?.addEventListener('change', filterTable);
        telradFilter?.addEventListener('input', filterTable);

        // ===============================
        // FILTERING
        // ===============================
        function _filterRows() {
            const search = (searchFilter?.value || "").trim().toLowerCase();
            const branch = (branchFilter?.value || "").trim().toLowerCase();
            const dept = (document.getElementById('departmentBtn')?.dataset.value || "").toLowerCase();
            const telrad = (telradFilter?.value || "").trim().toLowerCase();
            const rows = document.querySelectorAll('#employeeTableBody tr');
            rows.forEach(row => {
                const name = (row.dataset.name || "").toLowerCase();
                const rBranch = (row.dataset.branch || "").toLowerCase();
                const rDept = (row.dataset.department || "").toLowerCase();
                const assignedTelrad = (row.dataset.assignedtelrad || "").toLowerCase();
                const match =
                    (!search || name.includes(search)) &&
                    (!telrad || assignedTelrad.includes(telrad)) &&
                    (!branch || rBranch.includes(branch)) &&
                    (!dept || rDept.includes(dept));
                row.style.display = match ? "" : "none";
            });
        }

        // ===============================
        // DASHBOARD
        // ===============================
        function updateDashboard() {
            const rows = document.querySelectorAll('#employeeTableBody tr');
            const seenEmployees = new Set();
            const allTelrads = new Set();
            // For telrad-level active/inactive: a telrad is active if ANY of its employees is active
            const telradHasActive = {};
            let activeEmployees = 0;

            rows.forEach(row => {
                const telrad = (row.dataset.assignedtelrad || "").trim();
                const isActive = row.dataset.isactive === 'true';
                const name = (row.dataset.name || "").trim();

                if (name) seenEmployees.add(name);

                if (telrad) {
                    allTelrads.add(telrad);
                    if (isActive) {
                        telradHasActive[telrad] = true;
                        activeEmployees++;
                    } else {
                        if (telradHasActive[telrad] === undefined) telradHasActive[telrad] = false;
                    }
                }
            });

            const activeTelrads = Object.values(telradHasActive).filter(v => v).length;
            const inactiveTelrads = Object.values(telradHasActive).filter(v => !v).length;

            document.getElementById('countTotal').textContent = seenEmployees.size;
            document.getElementById('countActiveEmployees').textContent = activeEmployees;
            document.getElementById('countTotalTelrads').textContent = allTelrads.size;
            document.getElementById('countActive').textContent = activeTelrads;
            document.getElementById('countInactive').textContent = inactiveTelrads;
        }

        // ===============================
        // applyState — single row only
        // ===============================
        function applyState(targetRow, employeeActive) {
            const empBadge = targetRow.querySelector('.employee-status-badge');
            const toggleBtn = targetRow.querySelector('.toggle-active-btn');
            const icon = toggleBtn ? toggleBtn.querySelector('i') : null;

            if (empBadge) {
                empBadge.textContent = employeeActive ? 'Active' : 'Inactive';
                empBadge.className = 'badge employee-status-badge ' + (employeeActive ? 'bg-success' : 'bg-danger');
            }

            if (toggleBtn) {
                toggleBtn.dataset.isactive = employeeActive.toString();
                toggleBtn.title = employeeActive ? 'Set Inactive' : 'Set Active';
                toggleBtn.classList.toggle('active-state', employeeActive);
            }
            if (icon) {
                icon.className = employeeActive ? 'bi bi-toggle-on text-success' : 'bi bi-toggle-off text-danger';
            }

            targetRow.dataset.isactive = employeeActive.toString();
        }

        // Recompute and repaint the telrad-level badge for all rows sharing a telrad
        function refreshTelradBadge(assignedTelrad) {
            if (!assignedTelrad) return;
            const sharedRows = document.querySelectorAll(
                `#employeeTableBody tr[data-assignedtelrad="${assignedTelrad}"]`
            );
            const anyActive = Array.from(sharedRows).some(r => r.dataset.isactive === 'true');
            sharedRows.forEach(r => {
                const badge = r.querySelector('.telrad-status-badge');
                if (badge) {
                    badge.textContent = anyActive ? 'Active' : 'Inactive';
                    badge.className = 'badge telrad-status-badge ' + (anyActive ? 'bg-success' : 'bg-danger');
                }
            });
        }

        // ===============================
        // EDIT BUTTON
        // ===============================
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.edit-btn');
            if (!btn) return;
            const row = btn.closest('tr');
            row.classList.add('editing');
            row.querySelector('.save-form')?.classList.remove('d-none');
            row.querySelector('.delete-form')?.classList.remove('d-none');
            row.querySelector('.toggle-active-btn')?.classList.remove('d-none');
            row.querySelectorAll('.main-handler-checkbox').forEach(cb => cb.removeAttribute('disabled'));
            row.querySelectorAll('.edit-input').forEach(i => { i.style.display = 'block'; i.removeAttribute('readonly'); });
            row.querySelectorAll('.cell-text').forEach(s => s.style.display = 'none');
            btn.classList.add('d-none');
        });

        function exitEditMode(row) {
            row.classList.remove('editing');
            row.querySelector('.save-form')?.classList.add('d-none');
            row.querySelector('.delete-form')?.classList.add('d-none');
            row.querySelector('.toggle-active-btn')?.classList.add('d-none');
            row.querySelector('.edit-btn')?.classList.remove('d-none');
            row.querySelectorAll('.main-handler-checkbox').forEach(cb => cb.setAttribute('disabled', ''));
            row.querySelectorAll('.edit-input').forEach(i => { i.setAttribute('readonly', true); i.style.display = 'none'; });
            row.querySelectorAll('.cell-text').forEach(s => s.style.display = '');
        }

        // ===============================
        // SAVE BUTTON — reads from the ROW's edit inputs, not filter inputs
        // ===============================
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.save-btn');
            if (!btn) return;
            e.preventDefault();

            const form = btn.closest('.save-form');
            const row = form.closest('tr');

            // Read values from THIS ROW's edit inputs
            const id            = form.querySelector('input[name="Id"]').value;
            const fullName      = row.querySelector('input[name="FullName"]').value.trim();
            const branch        = row.querySelector('input[name="Branch"]').value.trim();
            const department    = row.querySelector('input[name="Department"]').value.trim();
            const position      = row.querySelector('input[name="Position"]') ? row.querySelector('input[name="Position"]').value.trim() : '';
            const number        = row.querySelector('input[name="Number"]').value.trim();
            const assignedTelrad = row.querySelector('input[name="AssignedTelrad"]').value.trim();
            const nearestTelrad = row.querySelector('input[name="NearestTelrad"]').value.trim();
            const isMainHandler = form.querySelector('input[name="IsMainHandler"]')?.value === 'true';

            const payload = {
                id: parseInt(id),
                fullName, branch, department, position,
                number, assignedTelrad, nearestTelrad,
                isMainHandler
            };

            fetch('/Employee/UpdateEmployee', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify(payload)
            })
            .then(async r => {
                const data = await r.json().catch(() => ({}));
                if (!r.ok) throw new Error(data.error || 'Save failed');

                const oldTelrad = row.dataset.assignedtelrad;

                // Update row data attributes
                row.dataset.name = fullName;
                row.dataset.branch = branch;
                row.dataset.department = department;
                row.dataset.assignedtelrad = assignedTelrad;

                // Update cell-text spans
                row.querySelector('td:nth-child(2) .cell-text').textContent = fullName;
                row.querySelector('td:nth-child(3) .cell-text').textContent = branch;
                const deptCell = row.querySelector('td:nth-child(4) .cell-text');
                deptCell.innerHTML = position
                    ? `${department}<br/><small class="text-muted">${position}</small>`
                    : department;
                row.querySelector('td:nth-child(5) .cell-text').textContent = number;
                row.querySelector('td:nth-child(6) .cell-text').textContent = assignedTelrad;
                row.querySelector('td:nth-child(7) .cell-text').textContent = nearestTelrad;

                // Handle telrad assignment changes on status badges
                if (!oldTelrad && assignedTelrad) {
                    // Was unassigned, now has telrad
                    const statusCell = row.querySelector('td:nth-child(8)');
                    if (statusCell) {
                        statusCell.innerHTML = `
                            <span class="badge employee-status-badge bg-success">Active</span>
                            <span class="badge telrad-status-badge bg-success ms-1">Telrad Active</span>`;
                    }
                    row.dataset.isactive = "true";
                } else if (oldTelrad && !assignedTelrad) {
                    // Telrad removed
                    const statusCell = row.querySelector('td:nth-child(8)');
                    if (statusCell) {
                        statusCell.innerHTML = `<span class="badge bg-secondary">No Telrad Assigned</span>`;
                    }
                    row.dataset.isactive = "false";
                }

                // Refresh telrad badges for old and new telrad groups
                refreshTelradBadge(oldTelrad);
                refreshTelradBadge(assignedTelrad);

                exitEditMode(row);
                updateDashboard();
            })
            .catch(err => {
                console.error(err);
                alert('Save failed: ' + err.message);
            });
        });

        // ===============================
        // MAIN HANDLER CHECKBOX
        // ===============================
        document.addEventListener('change', function (e) {
            const cb = e.target.closest('.main-handler-checkbox');
            if (!cb || cb.disabled) return;
            const telrad = cb.dataset.telrad;
            const employeeId = cb.dataset.employeeid;
            document.querySelectorAll(`.main-handler-checkbox[data-telrad="${telrad}"]`).forEach(other => {
                if (other !== cb) {
                    other.checked = false;
                    const hidden = other.closest('tr').querySelector('.main-handler-hidden');
                    if (hidden) hidden.value = "false";
                }
            });
            fetch('/Employee/UpdateMainHandler', {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ EmployeeId: employeeId, IsMainHandler: cb.checked, AssignedTelrad: telrad })
            }).then(resp => {
                if (!resp.ok) resp.text().then(t => alert('Failed to update main handler: ' + t));
            }).catch(err => alert('Error updating main handler'));
        });

        // ===============================
        // TOGGLE ACTIVE — scope modal
        // ===============================
        let _pendingToggle = null;

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.toggle-active-btn');
            if (!btn) return;

            const row = btn.closest('tr');
            const employeeId = btn.dataset.employeeid;
            const isActive = btn.dataset.isactive === 'true';
            const newState = !isActive;
            const assignedTelrad = row.dataset.assignedtelrad;
            const employeeName = (row.dataset.name || "this employee").trim();

            const sharedRows = document.querySelectorAll(
                `#employeeTableBody tr[data-assignedtelrad="${assignedTelrad}"]`
            );
            const hasMultiple = sharedRows.length > 1;

            _pendingToggle = { employeeId, isActive, newState, assignedTelrad, row, sharedRows };

            const action = newState ? 'activate' : 'deactivate';
            document.getElementById('toggleScopeMessage').innerHTML = hasMultiple
                ? `Telrad <strong>${assignedTelrad}</strong> has <strong>${sharedRows.length} employees</strong>.
                   Do you want to ${action} only <strong>${employeeName}</strong>, or the entire telrad?`
                : `Do you want to ${action} <strong>${employeeName}</strong>?`;

            // Always show the telrad button — even for single-employee telrads
            document.getElementById('toggleScopeTelrad').style.display = '';

            // But update the message to make it clear both options are available
            document.getElementById('toggleScopeMessage').innerHTML = hasMultiple
                ? `Telrad <strong>${assignedTelrad}</strong> has <strong>${sharedRows.length} employees</strong>.
                   Do you want to ${action} only <strong>${employeeName}</strong>, or the entire telrad?`
                : `Do you want to ${action} <strong>${employeeName}</strong> only, or mark the entire telrad as ${action}d?`;
            document.getElementById('toggleScopeModal').style.display = 'flex';
        });

        async function executeToggle(scope) {
            if (!_pendingToggle) return;
            const { employeeId, isActive, newState, assignedTelrad, row, sharedRows } = _pendingToggle;
            _pendingToggle = null;
            document.getElementById('toggleScopeModal').style.display = 'none';

            // Only this row, or all rows sharing the telrad
            const targetRows = scope === 'telrad' ? Array.from(sharedRows) : [row];

            // Optimistic UI
            targetRows.forEach(r => applyState(r, newState));
            refreshTelradBadge(assignedTelrad);

            try {
                const resp = await fetch('/Employee/UpdateActiveStatus', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        EmployeeId: parseInt(employeeId),
                        IsActive: newState,
                        AssignedTelrad: assignedTelrad,
                        Scope: scope
                    })
                });

                const text = await resp.text();
                if (!resp.ok) {
                    targetRows.forEach(r => applyState(r, isActive));
                    refreshTelradBadge(assignedTelrad);
                    showModal('Error', `Failed to update status (${resp.status}): ${text || 'no details'}`);
                    return;
                }

                updateDashboard();
            } catch (err) {
                targetRows.forEach(r => applyState(r, isActive));
                refreshTelradBadge(assignedTelrad);
                showModal('Error', 'Error updating status: ' + (err?.message ?? String(err)));
            }
        }

        document.getElementById('toggleScopeEmployee').addEventListener('click', () => executeToggle('employee'));
        document.getElementById('toggleScopeTelrad').addEventListener('click',   () => executeToggle('telrad'));
        document.getElementById('closeScopeModal').addEventListener('click', () => {
            document.getElementById('toggleScopeModal').style.display = 'none';
            _pendingToggle = null;
        });
        document.getElementById('cancelScopeModal').addEventListener('click', () => {
            document.getElementById('toggleScopeModal').style.display = 'none';
            _pendingToggle = null;
        });

        // ===============================
        // RESPONSE MODAL
        // ===============================
        const responseModal = document.getElementById('responseModal');
        const responseModalTitle = document.getElementById('responseModalTitle');
        const responseModalBody = document.getElementById('responseModalBody');

        function showModal(title, message, isSuccess = false) {
            responseModalTitle.textContent = title;
            responseModalBody.innerHTML = `<div class="alert ${isSuccess ? 'alert-success' : 'alert-danger'} mb-0">${message}</div>`;
            responseModal.style.display = 'flex';
        }

        function closeModal() { responseModal.style.display = 'none'; }

        document.getElementById('closeResponseModal').addEventListener('click', closeModal);
        document.getElementById('responseModalOk').addEventListener('click', closeModal);
        window.addEventListener('click', e => { if (e.target === responseModal) closeModal(); });

        // ===============================
        // INLINE ADD
        // ===============================
        if (inlineAddForm) {
            inlineAddForm.addEventListener('submit', async function (e) {
                e.preventDefault();

                const positionVal = document.getElementById('addPosition').value.trim();
                if (!positionVal) {
                    showModal('Validation Error', 'Position is required.');
                    document.getElementById('addPosition').classList.add('is-invalid');
                    return;
                }
                document.getElementById('addPosition').classList.remove('is-invalid');

                const payload = {
                    fullName:      searchFilter.value.trim(),
                    branch:        branchFilter.value.trim(),
                    department:    document.getElementById('departmentBtn')?.dataset.value || "",
                    assignedTelrad: telradFilter.value.trim(),
                    nearestTelrad: document.getElementById('addNearestTelrad').value.trim(),
                    position:      document.getElementById('addPosition').value.trim()
                };

                try {
                    const response = await fetch('/ManageEmployee/AddEmployee', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken':
                                document.querySelector('#inlineAddForm input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify(payload)
                    });

                    let data = {};
                    try { data = await response.json(); } catch {}

                    if (!response.ok) {
                        showModal('Error', data.error || 'Failed to add employee');
                        return;
                    }

                    showModal('Success', 'Employee added successfully.', true);

                    const tbody = document.getElementById('employeeTableBody');
                    const tr = document.createElement('tr');
                    tr.dataset.name = data.fullName || "";
                    tr.dataset.branch = data.branch || "";
                    tr.dataset.department = data.department || "";
                    tr.dataset.assignedtelrad = data.assignedTelrad || "";
                    tr.dataset.mainhandler = "false";
                    tr.dataset.isactive = "true";

                    tr.innerHTML = `
                        <td>
                            <input type="checkbox" class="main-handler-checkbox"
                                   data-telrad="${data.assignedTelrad}" data-employeeid="${data.id}" disabled />
                            <input type="hidden" class="main-handler-hidden" value="false">
                        </td>
                        <td class="text-start">
                            <span class="cell-text">${data.fullName}</span>
                            <input class="form-control edit-input" name="FullName" value="${data.fullName}" style="display:none;" />
                        </td>
                        <td>
                            <span class="cell-text">${data.branch}</span>
                            <input class="form-control edit-input" name="Branch" value="${data.branch}" style="display:none;" />
                        </td>
                        <td>
                            <span class="cell-text">
                                ${data.department}
                                ${data.position ? `<br/><small class="text-muted">${data.position}</small>` : ""}
                            </span>
                            <input class="form-control edit-input" name="Department" value="${data.department}" style="display:none;" />
                            <input class="form-control edit-input" name="Position" value="${data.position || ""}" style="display:none;" />
                        </td>
                        <td>
                            <span class="cell-text">${data.number || ""}</span>
                            <input class="form-control edit-input" name="Number" value="${data.number || ""}" style="display:none;" />
                        </td>
                        <td>
                            <span class="cell-text">${data.assignedTelrad}</span>
                            <input class="form-control edit-input" name="AssignedTelrad" value="${data.assignedTelrad}" style="display:none;" />
                        </td>
                        <td>
                            <span class="cell-text">${data.nearestTelrad || ""}</span>
                            <input class="form-control edit-input" name="NearestTelrad" value="${data.nearestTelrad || ""}" style="display:none;" />
                        </td>
                        <td>
                            ${data.assignedTelrad
                                ? `<span class="badge employee-status-badge bg-success">Active</span>
                                   <span class="badge telrad-status-badge bg-success ms-1">Telrad Active</span>`
                                : `<span class="badge bg-secondary">No Telrad Assigned</span>`}
                        </td>
                        <td class="actions-column">
                            <div class="d-flex gap-2 justify-content-end">
                                <button type="button" class="btn toggle-active-btn d-none active-state"
                                        data-employeeid="${data.id}" data-isactive="true" title="Set Inactive">
                                    <i class="bi bi-toggle-on text-success"></i>
                                </button>
                                <button type="button" class="btn btn-warning edit-btn btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form action="/Employee/UpdateEmployee" method="post" class="d-none save-form">
                                    <input type="hidden" name="Id" value="${data.id}" />
                                    <input type="hidden" name="IsMainHandler" class="main-handler-hidden" value="false" />
                                    <input type="hidden" name="FullName" value="${data.fullName}" />
                                    <input type="hidden" name="Branch" value="${data.branch}" />
                                    <input type="hidden" name="Department" value="${data.department}" />
                                    <input type="hidden" name="Position" value="${data.position || ""}" />
                                    <input type="hidden" name="Number" value="${data.number || ""}" />
                                    <input type="hidden" name="AssignedTelrad" value="${data.assignedTelrad}" />
                                    <input type="hidden" name="NearestTelrad" value="${data.nearestTelrad || ""}" />
                                    <button type="submit" class="btn btn-success save-btn btn-sm">Save</button>
                                </form>
                                <form action="/employee/deleteemployee" method="post" class="d-none delete-form"
                                      onsubmit="return confirm('delete this employee?');">
                                    <input type="hidden" name="id" value="${data.id}" />
                                    <button type="submit" class="btn delete-btn btn-danger btn-sm">delete</button>
                                </form>
                            </div>
                        </td>`;

                    tbody.appendChild(tr);
                    filterTable();
                    updateDashboard();
                    inlineAddForm.reset();
                    document.getElementById('addPosition').value = '';

                } catch (err) {
                    console.error(err);
                    showModal('Server Error', err.message);
                }
            });
        }

        // ===============================
        // PAGINATION
        // ===============================
        const PAGE_SIZE = 50;
        let currentPage = 1;

        function getFilteredRows() {
            const search = (searchFilter?.value || "").trim().toLowerCase();
            const branch = (branchFilter?.value || "").trim().toLowerCase();
            const dept = (document.getElementById('departmentBtn')?.dataset.value || "").toLowerCase();
            const telrad = (telradFilter?.value || "").trim().toLowerCase();
            return Array.from(document.querySelectorAll('#employeeTableBody tr')).filter(row => {
                const name = (row.dataset.name || "").toLowerCase();
                const rBranch = (row.dataset.branch || "").toLowerCase();
                const rDept = (row.dataset.department || "").toLowerCase();
                const assignedTelrad = (row.dataset.assignedtelrad || "").toLowerCase();
                return (!search || name.includes(search)) &&
                       (!telrad || assignedTelrad.includes(telrad)) &&
                       (!branch || rBranch.includes(branch)) &&
                       (!dept || rDept.includes(dept));
            });
        }

        function filterTable() {
            const search = (searchFilter?.value || "").trim().toLowerCase();
            const branch = (branchFilter?.value || "").trim().toLowerCase();
            const dept = (document.getElementById('departmentBtn')?.dataset.value || "").toLowerCase();
            const telrad = (telradFilter?.value || "").trim().toLowerCase();
            const rows = document.querySelectorAll('#employeeTableBody tr');
            rows.forEach(row => {
                const name = (row.dataset.name || "").toLowerCase();
                const rBranch = (row.dataset.branch || "").toLowerCase();
                const rDept = (row.dataset.department || "").toLowerCase();
                const assignedTelrad = (row.dataset.assignedtelrad || "").toLowerCase();
                const match =
                    (!search || name.includes(search)) &&
                    (!telrad || assignedTelrad.includes(telrad)) &&
                    (!branch || rBranch.includes(branch)) &&
                    (!dept || rDept.includes(dept));
                row.style.display = match ? "" : "none";
            });
            currentPage = 1;
            renderPage(1);
        }

        searchFilter?.addEventListener('input', filterTable);
        branchFilter?.addEventListener('change', filterTable);
        telradFilter?.addEventListener('input', filterTable);

        function renderPage(page) {
            const allRows = document.querySelectorAll('#employeeTableBody tr');
            const filteredRows = getFilteredRows();
            const total = filteredRows.length;
            const totalPages = Math.ceil(total / PAGE_SIZE) || 1;
            currentPage = Math.max(1, Math.min(page, totalPages));
            const start = (currentPage - 1) * PAGE_SIZE;
            const end = currentPage * PAGE_SIZE;
            const pageSet = new Set(filteredRows.slice(start, end));
            allRows.forEach(row => { row.style.display = pageSet.has(row) ? '' : 'none'; });
            renderPaginationControls(totalPages, total);
        }

        function renderPaginationControls(totalPages, totalRows) {
            let container = document.getElementById('paginationControls');
            if (!container) {
                container = document.createElement('div');
                container.id = 'paginationControls';
                container.className = 'd-flex justify-content-between align-items-center px-4 mt-3 mb-2';
                document.querySelector('.table-responsive').after(container);
            }
            const start = Math.min((currentPage - 1) * PAGE_SIZE + 1, totalRows);
            const end = Math.min(currentPage * PAGE_SIZE, totalRows);
            container.innerHTML = `
                <small class="text-muted">Showing ${start}–${end} of ${totalRows} records</small>
                <div class="d-flex gap-2 align-items-center">
                    <button class="btn btn-sm page-btn" id="btnFirst" ${currentPage === 1 ? 'disabled' : ''}>«</button>
                    <button class="btn btn-sm page-btn" id="btnPrev"  ${currentPage === 1 ? 'disabled' : ''}>‹</button>
                    <span class="small">Page ${currentPage} of ${totalPages}</span>
                    <button class="btn btn-sm page-btn" id="btnNext" ${currentPage >= totalPages ? 'disabled' : ''}>›</button>
                    <button class="btn btn-sm page-btn" id="btnLast" ${currentPage >= totalPages ? 'disabled' : ''}>»</button>
                </div>`;
            document.getElementById('btnFirst').addEventListener('click', () => { renderPage(1); window.scrollTo(0,0); });
            document.getElementById('btnPrev').addEventListener('click',  () => { renderPage(currentPage - 1); window.scrollTo(0,0); });
            document.getElementById('btnNext').addEventListener('click',  () => { renderPage(currentPage + 1); window.scrollTo(0,0); });
            document.getElementById('btnLast').addEventListener('click',  () => { renderPage(Math.ceil(totalRows / PAGE_SIZE)); window.scrollTo(0,0); });
        }


        // Initial sort: Active employees first, then inactive, then no telrad
        (function initialSort() {
            const tbody = document.getElementById('employeeTableBody');
            const rows = Array.from(tbody.querySelectorAll('tr'));
            rows.sort((a, b) => {
                const getRank = row => {
                    if (!row.dataset.assignedtelrad) return 2;
                    return row.dataset.isactive === 'true' ? 0 : 1;
                };
                return getRank(a) - getRank(b);
            });
            rows.forEach(row => tbody.appendChild(row));
        })();

        renderPage(1);
        updateDashboard();
    </script>
}