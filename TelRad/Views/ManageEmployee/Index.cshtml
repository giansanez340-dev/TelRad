@model TelRad.Models.Employee

@{
    ViewData["Title"] = "Add Employee";
}

<h2>Add Employee</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<form asp-action="Index" method="post">

    <!-- FULL NAME -->
    <div class="mb-3">

        <label class="form-label">
            Full Name
        </label>

        <input asp-for="FullName"
               class="form-control"
               required />

        <span asp-validation-for="FullName"
              class="text-danger"></span>

    </div>

    <!-- BRANCH -->
    <div class="mb-3">

        <label class="form-label">
            Branch
        </label>

        <select asp-for="Branch"
                class="form-select"
                id="branchSelect"
                required>

            <option value="">
                Select Branch
            </option>

            <option value="Agoo">
                Agoo
            </option>

            <option value="Candon">
                Candon
            </option>

            <option value="RM">
                RM
            </option>

            <option value="Pasig">
                Pasig
            </option>

        </select>

        <span asp-validation-for="Branch"
              class="text-danger"></span>

    </div>

    <!-- DEPARTMENT -->
    <div class="mb-3">

        <label class="form-label">
            Department
        </label>

        <select asp-for="Department"
                class="form-select"
                id="departmentSelect"
                required>

            <option value="">
                Select Department
            </option>

        </select>

        <span asp-validation-for="Department"
              class="text-danger"></span>

    </div>


    <!-- TELRAD -->
    <div class="mb-3">

        <label class="form-label">
            Assigned Telrad
        </label>

        <input asp-for="AssignedTelrad"
               class="form-control"
               required />

        <span asp-validation-for="AssignedTelrad"
              class="text-danger"></span>

    </div>

    <!-- BUTTON -->
    <button type="submit"
            class="btn btn-primary">

        Save Employee

    </button>

</form>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>

        const branchSelect =
            document.getElementById('branchSelect');

        const departmentSelect =
            document.getElementById('departmentSelect');

        const subDepartmentContainer =
            document.getElementById('subDepartmentContainer');

        const subDepartmentSelect =
            document.getElementById('subDepartmentSelect');

        // BRANCH -> DEPARTMENT
             const departments = {

                "Agoo": [
                    "Operator",
                    "EXECOM",
                    "LEAF",
                    "SAMPLE ROOM",
                    "AGRONOMY",
                    "SSDG",
                    "ACCOUNTING",
                    "HUMAN RESOURCES",
                    "INFORMATION TECHNOLOGY",
                    "BUYING LINE",
                    "CLINIC",
                    "CDF",
                    "OPERATION ACCOUNTING",
                    "LEAF ACCOUNTING",
                    "TREASURY",
                    "PROCUREMENT & SHIPPING",
                    "LEGAL",
                    "CORPORATE AFFAIRS",
                    "BLENDING LINE",
                    "QUALITY CONTROL",
                    "ENGINEERING",
                    "EHSS",
                    "FINISHED GOODS",
                    "PRODUCTION",
                    "SCALEHOUSE",
                    "TRAFFIC MANAGEMENT GROUP",
                    "GREEN LEAF LOGISTIC",
                    "BUYING LINE",
                    "SAN JACINTO"
                    ],

                "Candon": {

                    "EXECOM": [],

                    "FINANCE": [
                        "OPERATIONS ACCOUNTING",
                        "INFORMATION TECHNOLOGY",
                        "HUMAN RESOURCE",
                        "TREASURY",
                        "PROCUREMENT & SHIPPING"
                    ],

                    "INTERNAL OPERATIONS": [
                        "GLLM",
                        "GLLM & TMG CURRIMAO",
                        "ACCOUNTING CURRIMAO",
                        "TREASURY CURRIMAO",
                        "ADMIN & LOGISTICS",
                        "ENGINEERING",
                        "GUARD"
                    ],

                    "GROWING OPERATIONS": [
                        "MANAGERS",
                        "RISK MANAGEMENT",
                        "SSDG",
                        "BUYING",
                        "FRU",
                        "RTF",
                        "AGRONOMY",
                        "FRA CURRIMAO",
                        "STA CRUZ WAREHOUSE"
                    ]
                },

                "RM": {

                    "Operator": [],

                    "FINANCE": [],

                    "LEAF AND SALES": [
                        "GENERAL ACCOUNTING",
                        "LEAF ACCOUNTING",
                        "OPERATIONS ACCOUNTING",
                        "FILLING ROOM",
                        "INFORMATION TECHNOLOGY",
                        "TREASURY",
                        "PROCUREMENT & SHIPPING",
                        "LEGAL",
                        "CORPORATE AFFAIRS",
                        "PROJECT MANAGERS",
                        "AGRONOMY",
                        "TOBACCO WRAPPER",
                        "SSDG",
                        "COMPLIANCE",
                        "FRA"
                    ],

                    "INTERNAL OPERATIONS": [
                        "HUMAN RESOURCES",
                        "HR",
                        "EHSS",
                        "TRAFFIC AND LOGISTICS",
                        "CLINIC",
                        "GUARD"
                    ],

                    "GROWING OPERATIONS": [
                        "GO DIRECTOR R2",
                        "AGRONOMY DIRECTOR",
                        "RTF",
                        "GUEST HOUSE"
                    ]
                },

                "Pasig": {
                    "Operator": [],

                    "EXECOM": [],

                    "FINANCE": [
                        "CONFERENCE",
                        "PROCUREMENT & SHIPPING",
                        "TREASURY",
                        "OTHERS",
                        "PANTRY",
                        "CORPORATE AFFAIRS"
                    ]
                }
            };

        // WHEN BRANCH CHANGES
        branchSelect.addEventListener('change', function () {

            const selectedBranch = this.value;

            departmentSelect.innerHTML =
                '<option value="">Select Department</option>';

            subDepartmentContainer.style.display =
                'none';

            subDepartmentSelect.innerHTML =
                '<option value="">Under</option>';

            if (departments[selectedBranch]) {

                Object.keys(departments[selectedBranch])
                    .forEach(function (department) {

                    const option =
                        document.createElement('option');

                    option.value =
                        department;

                    option.text =
                        department;

                    departmentSelect.appendChild(option);
                });
            }
        });

        // WHEN DEPARTMENT CHANGES
        departmentSelect.addEventListener('change', function () {

            const selectedBranch =
                branchSelect.value;

            const selectedDepartment =
                this.value;

            subDepartmentSelect.innerHTML =
                '<option value="">None</option>';

            const subDepartments =
                departments[selectedBranch][selectedDepartment];

            if (subDepartments.length > 0) {

                subDepartmentContainer.style.display =
                    'block';

                subDepartments.forEach(function (subDept) {

                    const option =
                        document.createElement('option');

                    option.value =
                        subDept;

                    option.text =
                        subDept;

                    subDepartmentSelect.appendChild(option);
                });
            }
            else {

                subDepartmentContainer.style.display =
                    'none';
            }
        });

    </script>
}